# syntax=docker/dockerfile:1.7
# NanoClaw Host Process
# Runs the Node.js host that routes messages and spawns per-session agent containers.
# The agent container image is built separately via container/build.sh.

FROM node:22-slim

# Pin versions for reproducibility — bump deliberately.
ARG PNPM_VERSION=9.15.4

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Install runtime system deps
# docker-ce-cli: nanoclaw spawns agent containers via the host daemon (DOOD).
#   The socket is bind-mounted at runtime; the CLI must be in the image.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        sqlite3 \
        tini \
        ca-certificates \
        curl \
        gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first (cached independently of source edits)
WORKDIR /opt/nanoclaw
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Source
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY tsconfig.json ./

RUN pnpm run build

# /var/run/docker.sock is mounted at runtime — not baked in.
# The host process must run as root to access the Docker socket.
# All agent containers drop to uid 1000 (node) independently.

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
