# NanoClaw environment variables
# Copy to .env and fill in your values before running: cp .env.example .env

# ── Core ──────────────────────────────────────────────────────────────────────

# Display name used in agent responses
ASSISTANT_NAME=NanoClaw

# Timezone for scheduled tasks and log timestamps (e.g. America/New_York, Europe/London)
TZ=PST

# ── OneCLI credential gateway ─────────────────────────────────────────────────
# OneCLI runs natively on the VM host (not in Docker).
# The nanoclaw container reaches it via the Docker host-gateway alias.
# Default after `onecli start`: http://host-gateway:10254
# Set by docker-compose.yml — only override here if running without compose.
# ONECLI_URL=http://host-gateway:10254

# ── Other channels ─────────────────────────────────────────────────────────────
# Uncomment and fill in after running the relevant /add-<channel> skill.

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to true if your assistant has its own phone number (for WhatsApp/iMessage)
# ASSISTANT_HAS_OWN_NUMBER=false

# ── Discord (installed via /add-discord skill) ─────────────────────────────────
# These may also be added to onecli
#DISCORD_BOT_TOKEN=
#DISCORD_APPLICATION_ID=
#DISCORD_PUBLIC_KEY=

